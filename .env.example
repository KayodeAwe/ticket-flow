# Copy to .env and fill in, or run `npm run bootstrap`. .env is gitignored and must never be committed.

# --- API and dispatcher ---
# Connection string. Must point at a replica set: issuing a ticket writes the ticket, its
# audit event and its outbox message in one transaction, and standalone MongoDB has no
# transactions.
MONGODB_URI=mongodb://localhost:27017/ticketflow?replicaSet=rs0&directConnection=true

# No default exists in code. The API refuses to start if this is unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-generated-secret

# Minutes a signed token stays valid.
JWT_TTL_MINUTES=60

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Origin allowed to call the API from a browser (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# --- Ticket delivery (dispatcher only) ---
# Docker Compose runs Mailpit, which accepts every message and shows it at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=tickets@ticket-flow.example.test

# --- Seed data (development only) ---
# Password given to every seeded demo account. Seed refuses to run when NODE_ENV=production.
SEED_PASSWORD=replace-me-for-local-demo-only
